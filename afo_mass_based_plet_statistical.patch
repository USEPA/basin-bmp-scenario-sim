@@ -0,0 +1,48 @@
+"""Create a *demonstration-only* AFO mass-method GeoPackage (no binary patch).
+
+Run from the repository root: python scripts/create_afo_mass_example.py
+This copies, never overwrites, the legacy concentration-increment example.
+Neither operation represents a verified livestock site in East Fork.
+"""
+from pathlib import Path
+import shutil
+import sqlite3
+
+import pandas as pd
+
+ROOT = Path(__file__).resolve().parents[1]
+DIRECTORY = ROOT / "examples" / "east_fork" / "inputs" / "afo"
+SOURCE = DIRECTORY / "afo_example.gpkg"
+TARGET = DIRECTORY / "afo_mass_example_generated.gpkg"
+
+
+def main() -> None:
+    if not SOURCE.is_file():
+        raise FileNotFoundError(SOURCE)
+    if TARGET.exists():
+        raise FileExistsError(f"Refusing to overwrite existing example: {TARGET}")
+    shutil.copyfile(SOURCE, TARGET)
+    with sqlite3.connect(TARGET) as conn:
+        pd.DataFrame([
+            {"afo_id": "AFO_DEMO_01", "season": "spring", "solids_pct": 25.,
+             "wep_fraction": .30, "f_n": .20, "alpha_n": 1.,
+             "collection_fraction": .8, "export_fraction": .1,
+             "n_retention_fraction": .75, "p_retention_fraction": .95,
+             "incorporated_fraction": .1},
+            {"afo_id": "AFO_DEMO_02", "season": "fall", "solids_pct": 20.,
+             "wep_fraction": .30, "f_n": .20, "alpha_n": 1.,
+             "collection_fraction": .8, "export_fraction": .1,
+             "n_retention_fraction": .75, "p_retention_fraction": .95,
+             "incorporated_fraction": .1},
+        ]).to_sql("afo_manure_management", conn, index=False)
+        pd.DataFrame([{"pid": pid, "eligible": 1} for pid in (1,2,3,4)]).to_sql(
+            "afo_field_eligibility", conn, index=False)
+        pd.DataFrame([{"pid": None, "huc12": None, "annual_precip_mm": 1000.,
+                       "annual_runoff_mm": 200., "feedlot_runoff_mm": 300.}]).to_sql(
+            "afo_hydrology", conn, index=False)
+    print(f"Created {TARGET}")
+    print("WARNING: All AFO locations and parameters are illustrative, not observed East Fork data.")
+
+
+if __name__ == "__main__":
+    main()
